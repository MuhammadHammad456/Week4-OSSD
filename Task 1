marks_list = []
passed_count = 0
failed_count = 0

for i in range(1, 11):
    while True:
        try:
            mark = float(input(f"Enter marks for student {i} (0-100): "))
            if 0 <= mark <= 100:
                break
            print("Invalid input. Marks must be between 0 and 100.")
        except ValueError:
            print("Invalid input. Please enter a numeric value.")

    marks_list.append(mark)

    if mark >= 90:
        grade = "A"
    elif mark >= 80:
        grade = "B"
    elif mark >= 70:
        grade = "C"
    elif mark >= 60:
        grade = "D"
    else:
        grade = "F"

    if mark >= 50:
        passed_count += 1
    else:
        failed_count += 1

    print(f"Student {i}: Marks = {mark}, Grade = {grade}")

highest_mark = max(marks_list)
class_average = sum(marks_list) / len(marks_list)

print("\n--- Performance Summary ---")
print(f"Passed students: {passed_count}")
print(f"Failed students: {failed_count}")
print(f"Highest mark: {highest_mark}")
print(f"Class average: {class_average:.2f}")
